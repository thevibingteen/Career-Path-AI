# CareerPath AI Environment Configuration

# Optional: Google Gemini API Key for AI personalization & career coaching
# Get a free API key at: https://aistudio.google.com/
# If omitted, CareerPath AI operates seamlessly in zero-cost Local Guidance Mode.
GEMINI_API_KEY=

# Optional: Gemini Model override (defaults to current free-tier model)
GEMINI_MODEL=gemini-3.8-flash

# Optional: API timeout in milliseconds (default: 15000)
GEMINI_TIMEOUT_MS=15000

# Optional: Server Port for local development (default: 3000)
PORT=3000
